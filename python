import random

# Компьютер загадывает случайное число от 1 до 20
secret_number = random.randint(1, 20)
attempts = 0

print("Привет! Я загадал число от 1 до 20. Попробуй угадать!")

while True:
    # Получаем ответ от пользователя и превращаем его в целое число
    guess = int(input("Введи свой вариант: "))
    attempts += 1

    # Проверяем, угадал ли игрок
    if guess < secret_number:
        print("Мое число больше! Попробуй еще раз.")
    elif guess > secret_number:
        print("Мое число меньше! Попробуй еще раз.")
    else:
        print(f"Поздравляю! Ты угадал число {secret_number} за {attempts} попыток!")
        break  # Выходим из цикла, так как игра окончена
